<!DOCTYPE html>
<html lang="hi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>राष्ट्रीय सेवा मिशन फाउंडेशन ट्रस्ट</title>

<style>
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:Arial,sans-serif;color:#222;background:#fff;line-height:1.7}
.top{background:#8b0000;color:#fff;padding:10px;text-align:center;font-size:14px}
.top span{margin:0 12px}
nav{background:#fff;padding:18px;text-align:center;box-shadow:0 2px 10px #ccc}
.brand{font-size:25px;font-weight:bold;color:#8b0000;margin-bottom:12px}
.links a{color:#222;text-decoration:none;margin:8px;font-weight:bold}
.hero{padding:100px 20px;text-align:center;color:#fff;background:linear-gradient(#0008,#0008),url("https://images.unsplash.com/photo-1469571486292-0ba58a3f068b?auto=format&fit=crop&w=1600&q=80") center/cover}
.hero h1{font-size:50px}
.hero b{color:#ffd700}
.hero p{font-size:22px;margin:15px}
.btn{display:inline-block;background:#8b0000;color:white;padding:13px 25px;border-radius:25px;text-decoration:none;border:0;font-weight:bold;margin-top:15px}
section{max-width:1100px;margin:auto;padding:55px 20px}
h2{text-align:center;color:#8b0000;font-size:32px;margin-bottom:30px}
.about{display:flex;gap:30px;align-items:center}
.about div{flex:1;font-size:18px}
.about img{width:320px;border-radius:15px}
.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:20px}
.cards article{padding:30px 20px;text-align:center;background:#fff8e8;border-radius:15px;box-shadow:0 3px 15px #ddd}
.cards span{font-size:40px}
.cards h3{color:#8b0000;margin:10px}
.founder{display:flex;align-items:center;gap:35px;background:#fff8e8;padding:30px;border-radius:18px}
.founder img{width:220px;border-radius:15px}
.founder h3{font-size:30px;color:#8b0000}
.join{background:#fafafa}
form{max-width:800px;margin:auto}
input,textarea,select{width:100%;padding:13px;margin:7px 0 15px;border:1px solid #ccc;border-radius:8px}
textarea{height:100px}
label{font-weight:bold}
.contact{text-align:center;font-size:18px}
.contact a{color:#8b0000;font-weight:bold}
footer{background:#222;color:white;text-align:center;padding:25px}

@media(max-width:650px){
.top span{display:block;margin:3px}
.hero h1{font-size:36px}
.about,.founder{display:block;text-align:center}
.about img,.founder img{width:90%;max-width:320px;margin:20px auto}
.links a{display:inline-block}
}
</style>
</head>

